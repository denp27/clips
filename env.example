# Токен бота, полученный у @BotFather
BOT_TOKEN=123456:AA...

# Telegram user_id админов через запятую (узнать свой id можно у @userinfobot)
ADMIN_IDS=111111111,222222222

# Публичный https-адрес, на котором будет доступен мини-апп
# (для теста можно использовать ngrok / cloudflared, Telegram требует HTTPS)
WEBAPP_URL=https://your-domain.example.com

# Порт, на котором поднимается FastAPI-сервер
PORT=8000
