<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Dani Clips — Клипы</title>
<link rel="stylesheet" href="/assets/css/style.css" />
<script src="https://telegram.org/js/telegram-web-app.js"></script>
</head>
<body>
<div class="container">
  <h1 class="page-title">Мои офферы</h1>

  <div id="selectedOfferBox"></div>

  <div id="submissionsList"></div>

  <div class="card">
    <div style="text-align:center;">
      <div class="muted">Для публикации видео в TikTok</div>
      <div class="muted">Вводи этот код в хэштеги под каждым своим видео</div>
      <button class="btn btn-primary" style="margin-top:10px;" onclick="getCode()">Получить код</button>
      <div id="codeBox" class="muted" style="margin-top:8px;"></div>
    </div>
  </div>

  <div class="section-title">История</div>
  <div class="muted" style="margin-bottom:6px;">НЕДАВНИЕ ПРИНЯТЫЕ</div>
  <div id="acceptedList"></div>
</div>

<script src="/assets/js/app.js"></script>
<script>
function statusPill(status) {
  const map = { pending: ["На проверке", "status-pending"], accepted: ["Принято", "status-accepted"], rejected: ["Отклонено", "status-rejected"] };
  const [label, cls] = map[status] || [status, "status-pending"];
  return `<span class="status-pill ${cls}">${label}</span>`;
}

async function renderSelectedOfferBox() {
  const offerId = localStorage.getItem("selectedOfferId");
  const offerTitle = localStorage.getItem("selectedOfferTitle");
  const box = document.getElementById("selectedOfferBox");
  if (!offerId) {
    box.innerHTML = `<div class="empty-state">
      <div class="big-icon">📥</div>
      У вас нет активных офферов<br/>
      <span class="muted">Перейдите на главную, чтобы выбрать оффер</span>
    </div>`;
    return;
  }
  box.innerHTML = `
    <div class="card">
      <div class="title">Оффер: ${offerTitle}</div>
      <label style="margin-top:10px;">Аккаунт TikTok (@username)</label>
      <input id="tiktokAccount" placeholder="@ваш_аккаунт" />
      <label>Ссылка на видео</label>
      <input id="videoUrl" placeholder="https://www.tiktok.com/@.../video/..." />
      <button class="btn btn-accent" onclick="submitVideo(${offerId})">Отправить видео на проверку</button>
    </div>`;
}

async function submitVideo(offerId) {
  const video_url = document.getElementById("videoUrl").value.trim();
  const tiktok_account = document.getElementById("tiktokAccount").value.trim();
  if (!video_url) { showToast("Укажите ссылку на видео"); return; }
  try {
    await api("/api/submissions", {
      method: "POST",
      body: JSON.stringify({ offer_id: offerId, video_url, tiktok_account }),
    });
    showToast("Видео отправлено на проверку");
    document.getElementById("videoUrl").value = "";
    await loadSubmissions();
  } catch (e) {
    showToast("Ошибка: " + e.message);
  }
}

function getCode() {
  api("/api/me").then(me => {
    const code = "SC" + me.tg_id;
    document.getElementById("codeBox").textContent = "Ваш код: " + code;
  });
}

async function loadSubmissions() {
  const subs = await api("/api/submissions");
  const list = document.getElementById("submissionsList");
  const accepted = subs.filter(s => s.status === "accepted");
  const acceptedList = document.getElementById("acceptedList");

  if (!subs.length) {
    list.innerHTML = "";
  } else {
    list.innerHTML = `<div class="section-title">Отправленные видео</div>` + subs.map(s => `
      <div class="card">
        <div class="offer-row">
          <div>
            <div class="title">${s.offer_title}</div>
            <div class="channel">Аккаунт: ${s.tiktok_account || "—"}</div>
            <div class="muted" style="margin-top:4px;word-break:break-all;">${s.video_url}</div>
          </div>
          ${statusPill(s.status)}
        </div>
        <div class="muted" style="margin-top:8px;">Просмотров: ${s.views} · Начислено: ${s.earned.toFixed(2)} ₽</div>
      </div>
    `).join("");
  }

  acceptedList.innerHTML = accepted.length
    ? accepted.map(s => `<div class="card"><div class="title">${s.offer_title}</div><div class="muted">${s.views} просмотров · +${s.earned.toFixed(2)} ₽</div></div>`).join("")
    : `<div class="muted">Нет недавних клипов</div>`;
}

(async () => {
  await maybeShowAdminLink();
  await renderSelectedOfferBox();
  await loadSubmissions();
})();

renderBottomNav("clips");
</script>
</body>
</html>
